{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commandalkon.com/schemas/command-cloud/monetary-amount.json",
  "title": "MonetaryAmount",
  "description": "ISO 4217 monetary amount used across Command Cloud transactional entities.",
  "type": "object",
  "required": ["value", "currency"],
  "additionalProperties": false,
  "properties": {
    "value": {
      "type": "number",
      "description": "Amount in major currency units (e.g. 10.50 for ten euro fifty)."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code (EUR, GBP, USD)."
    }
  }
}
